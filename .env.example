# 服务端口与监听地址
PORT=3000
HOST=0.0.0.0

# 开发数据库；生产必须改为独立路径，禁止复用演示库
DB_PATH=./data/library.db

# 生产必须为 true，并通过 HTTPS 访问；开发本机 HTTP 使用 false
COOKIE_SECURE=false

# 只填写确实由你控制的代理网段；留空不信任转发 IP 头
# TRUST_PROXY=loopback

# 备份命令使用；生产应使用受限目录并额外同步到异地存储
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# 生产环境首次启动空数据库时必须设置；至少 12 字符的独立强密码
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
