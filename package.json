{
  "name": "library-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --experimental-sqlite --env-file-if-exists=.env server/index.js --production",
    "preview": "node --experimental-sqlite --env-file-if-exists=.env server/index.js --production",
    "test": "node --experimental-sqlite --test --experimental-test-isolation=none \"server/tests/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "quality": "npm run lint && npm test && npm run quality --workspace=@jcc/shared && npm run build",
    "db:backup": "node --experimental-sqlite --env-file-if-exists=.env scripts/database.mjs backup",
    "db:restore": "node --experimental-sqlite scripts/database.mjs restore"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@jcc/shared": "0.1.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.2",
      "editorconfig": { "minimatch": "^11.0.1" }
    },
    "glob": { "minimatch": "^11.0.1" },
    "eslint": { "minimatch": "^11.0.1" },
    "@eslint/config-array": { "minimatch": "^11.0.1" }
  }
}
